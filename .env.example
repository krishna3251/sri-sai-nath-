# Neon PostgreSQL. Keep secrets server-side; never expose DATABASE_URL in client code.
DATABASE_URL=

# Configure authentication before any real business data is stored.
AUTH_SECRET=

# Future local Windows connector to TallyPrime. Do not expose Tally's local HTTP port publicly.
TALLY_CONNECTOR_URL=
TALLY_CONNECTOR_TOKEN=

# Single-shop gate; never use NEXT_PUBLIC_ for these. Generate a random secret of at least 32 characters.
SHOP_PIN=
SHOP_SESSION_SECRET=
# Local HTTP testing only; omit on hosted HTTPS previews.
# SHOP_COOKIE_SECURE=false
